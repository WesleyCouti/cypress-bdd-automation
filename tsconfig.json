{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": [
      "cypress",
      "node",
      "@badeball/cypress-cucumber-preprocessor"
    ]
  },
  "include": [
    "cypress/**/*.ts",
    "cypress.config.ts"
  ]
}